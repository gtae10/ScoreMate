# 로컬 개발용 환경변수 템플릿.
# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 .gitignore에 등록되어 커밋되지 않습니다.
#
#   cp .env.example .env

# MySQL 접속 정보 (아래 URL은 로컬 기본값 예시 - DB명/포트가 다르면 맞게 수정)
DB_URL=jdbc:mysql://127.0.0.1:3306/scoremate?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=scoremate
DB_PASSWORD=

# JWT 서명 시크릿 (최소 32바이트 이상의 무작위 문자열 권장)
JWT_SECRET=
